module

public import FormalConjecturesUtil

/-!
# Problem 21.8

by V. G. Bardakov, A. L. Iskra

For $0 \le r < m$ let $r(m) = \{r + tm \mid t \in \mathbb{Z}\}$. For disjoint residue classes
$r_1(m_1)$ and $r_2(m_2)$, the *class transposition* $\tau_{r_1(m_1), r_2(m_2)}$ is the involution
of $\mathbb{Z}$ that interchanges $r_1 + t m_1$ and $r_2 + t m_2$ for each integer $t$ and fixes
everything else. The problem concerns only class transpositions with equal moduli.

The answer is yes, by Pan [Pa] and independently by van Doorn, Judin, Monticone and Morrison
[vDJMM, Theorem 6.1].

*References:*
- [The Kourovka Notebook](https://arxiv.org/abs/1401.0300v48), Problem 21.8.
- [Pa] J. Pan, *A note on the horizontal class transposition group*,
  [arXiv:2604.12553](https://arxiv.org/abs/2604.12553).
- [vDJMM] W. van Doorn, E. Judin, P. Monticone and D. Morrison, *On some problems from the
  Kourovka Notebook*, [arXiv:2607.17477](https://arxiv.org/abs/2607.17477).
-/

@[expose] public section

namespace Kourovka.«21.8»

/--
The underlying function of the class transposition $\tau_{r_1(m), r_2(m)}$ for
$0 \le r_1, r_2 < m$ with $r_1 \ne r_2$: it maps $r_1 + tm$ to $r_2 + tm$, maps $r_2 + tm$ to
$r_1 + tm$, and fixes every other integer.
-/
def classTranspositionFun (m r₁ r₂ : ℤ) (n : ℤ) : ℤ :=
  if n % m = r₁ then n - r₁ + r₂ else if n % m = r₂ then n - r₂ + r₁ else n

@[category test, AMS 20]
theorem classTranspositionFun_test :
    classTranspositionFun 3 0 2 6 = 8 ∧ classTranspositionFun 3 0 2 (-1) = -3 ∧
      classTranspositionFun 3 0 2 4 = 4 := by
  decide

/--
The group $\mathrm{CT}_{(k)} = \langle \mathrm{CT}_2, \dots, \mathrm{CT}_k \rangle$, where
$\mathrm{CT}_m$ is the subgroup of $\mathrm{Sym}(\mathbb{Z})$ generated by the class
transpositions $\tau_{r_1(m), r_2(m)}$ for $0 \le r_1 \ne r_2 < m$.
-/
def CT (k : ℕ) : Subgroup (Equiv.Perm ℤ) :=
  Subgroup.closure {σ | ∃ m r₁ r₂ : ℕ, 2 ≤ m ∧ m ≤ k ∧ r₁ < m ∧ r₂ < m ∧ r₁ ≠ r₂ ∧
    ⇑σ = classTranspositionFun m r₁ r₂}

/--
Let $\mathrm{CT}_k$ be the subgroup of $\mathrm{CT}(\mathbb{Z})$ generated by the class
transpositions $\tau_{r_1(k), r_2(k)}$ for $0 \le r_1 \ne r_2 < k$, and let
$\mathrm{CT}_{(k)} = \langle \mathrm{CT}_2, \mathrm{CT}_3, \dots, \mathrm{CT}_k \rangle$. Is it true
that for $k > 3$ the group $\mathrm{CT}_{(k)}$ is isomorphic to the symmetric group $S_N$, where
$N$ is the least common multiple of the numbers $2, 3, \dots, k$?
-/
@[category research solved, question, AMS 20,
  formal_proof using lean4 at
    "https://github.com/pitmonticone/Kourovka/blob/dcfdbdad8c434e30f6151fb3b4343364d70eeed4/Kourovka/Problem_21_8.lean#L2379"]
theorem kourovka_21_8 :
    ∀ k : ℕ, 3 < k → Nonempty (CT k ≃* Equiv.Perm (Fin ((Finset.Icc 2 k).lcm id))) := by
  sorry

end Kourovka.«21.8»
